pipeline {
  agent any
  options { timestamps(); ansiColor('xterm') }
  parameters {
    booleanParam(name: 'DEPLOY_TO_K8S', defaultValue: false, description: 'Apply Kubernetes manifests after a successful build')
    string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Container image tag')
  }
  environment {
    VENV = '.venv'
    PYTHONPATH = "${WORKSPACE}"
    MLFLOW_EXPERIMENT_NAME = 'voyage-analytics-jenkins'
  }
  stages {
    stage('Install') {
      steps { sh 'python3 -m venv $VENV && . $VENV/bin/activate && pip install --upgrade pip && pip install -r requirements.txt' }
    }
    stage('Train') {
      steps { sh '. $VENV/bin/activate && make train' }
    }
    stage('Test') {
      steps { sh '. $VENV/bin/activate && pytest -q' }
      post { always { junit allowEmptyResults: true, testResults: 'reports/junit.xml' } }
    }
    stage('Build images') {
      steps { sh 'docker build -f docker/Dockerfile.api -t voyage-analytics-api:${IMAGE_TAG} . && docker build -f docker/Dockerfile.streamlit -t voyage-analytics-dashboard:${IMAGE_TAG} .' }
    }
    stage('Deploy') {
      when { expression { return params.DEPLOY_TO_K8S } }
      steps { sh 'kubectl apply -k kubernetes/' }
    }
  }
}
